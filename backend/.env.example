PORT=5001
MONGO_URI=mongodb+srv://<username>:<db_password>@cluster0.xxxxxx.mongodb.net/homecrew
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=5d

# Comma separated list of allowed frontend URLs (CORS)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Used by "npm run seed" to create the first admin
ADMIN_NAME=HomeCrew Admin
ADMIN_EMAIL=admin@homecrew.com
ADMIN_PASSWORD=adminPassword

# Razorpay Payment Gateway & Financials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
PLATFORM_COMMISSION_PERCENT=10
MAX_CASH_DEBT_LIMIT=500
