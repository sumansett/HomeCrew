PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/homecrew
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=5d

# Comma separated list of allowed frontend URLs (CORS)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Used by "npm run seed" to create the first admin
ADMIN_NAME=HomeCrew Admin
ADMIN_EMAIL=admin@homecrew.com
ADMIN_PASSWORD=admin123

# Return the OTP in the API response (testing only - turn OFF in production)
OTP_DEBUG=false

# Gmail SMTP for OTP emails
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_char_google_app_password

# Twilio Verify for live SMS OTP (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# Razorpay Payment Gateway & Financials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
PLATFORM_COMMISSION_PERCENT=10
MAX_CASH_DEBT_LIMIT=500
